{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "PowerAppsChecker",
          "rules": [
            { "id": "app-checker-type-mismatch", "name": "TypeMismatch" },
            { "id": "app-checker-naming", "name": "NamingConvention" },
            { "id": "app-checker-line-drift", "name": "LineDrift" },
            { "id": "app-checker-new-issue", "name": "NewIssue" },
            { "id": "app-checker-new-warning", "name": "NewWarning" }
          ]
        }
      },
      "results": [
        {
          "ruleId": "app-checker-type-mismatch",
          "level": "error",
          "message": { "text": "Expected type Number but received Text." },
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "Screen1.fx.yaml" }, "region": { "startLine": 12 } } }
          ]
        },
        {
          "ruleId": "app-checker-naming",
          "level": "note",
          "message": { "text": "Control name does not follow naming convention." },
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "Screen2.fx.yaml" }, "region": { "startLine": 30 } } }
          ]
        },
        {
          "ruleId": "app-checker-line-drift",
          "level": "error",
          "message": { "text": "Formula references undefined collection." },
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "Screen3.fx.yaml" }, "region": { "startLine": 50 } } }
          ]
        },
        {
          "ruleId": "app-checker-new-issue",
          "level": "error",
          "message": { "text": "New error introduced by this change." },
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "Screen4.fx.yaml" }, "region": { "startLine": 8 } } }
          ]
        },
        {
          "ruleId": "app-checker-new-warning",
          "level": "warning",
          "message": { "text": "New warning introduced by this change." },
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "Screen5.fx.yaml" }, "region": { "startLine": 3 } } }
          ]
        }
      ]
    }
  ]
}
